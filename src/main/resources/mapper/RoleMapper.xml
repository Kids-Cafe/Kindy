<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTO Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.kidscafe.kindy.mapper.IRoleMapper">
    <select id="getList" parameterType="RelationshipDTO" resultType="RelationshipDTO">
        SELECT ID, KINDERGARTEN_ID, NAME
        FROM T_ROLE
        WHERE KINDERGARTEN_ID = #{kindergartenId}
    </select>

    <select id="getInfo" parameterType="RelationshipDTO" resultType="RelationshipDTO">
        SELECT ID, KINDERGARTEN_ID, NAME
        FROM T_ROLE
        WHERE ID = #{id}
    </select>

    <insert id="insert" parameterType="RelationshipDTO">
        INSERT INTO T_ROLE(KINDERGARTEN_ID, NAME)
        VALUES (#{kindergartenId}, #{name})
    </insert>

    <update id="updateName" parameterType="RelationshipDTO">
        UPDATE T_ROLE
        SET NAME = #{name}
        WHERE ID = #{id}
    </update>

    <delete id="delete" parameterType="RelationshipDTO">
        DELETE FROM T_ROLE
        WHERE ID = #{id}
    </delete>
</mapper>