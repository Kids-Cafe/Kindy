<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTO Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.kidscafe.kindy.mapper.IClassMapper">
    <select id="selectList" resultType="ClassDTO">
        SELECT ID, KINDERGARTEN_ID, NAME
        FROM T_CLASS
        WHERE KINDERGARTEN_ID = #{kindergartenId}
    </select>

    <select id="select" resultType="ClassDTO">
        SELECT ID, KINDERGARTEN_ID, NAME
        FROM T_CLASS
        WHERE ID = #{id}
    </select>

    <insert id="insert">
        INSERT INTO T_CLASS(KINDERGARTEN_ID, NAME)
        VALUES (#{kindergartenId}, #{name})
    </insert>

    <update id="update">
        UPDATE T_CLASS
        SET NAME = #{name}
        WHERE ID = #{id}
    </update>

    <delete id="delete">
        DELETE FROM T_CLASS
        WHERE ID = #{id}
    </delete>
</mapper>