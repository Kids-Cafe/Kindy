<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTO Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.kidscafe.kindy.mapper.IPhotoMapper">
    <select id="selectList" resultType="ScheduleDTO">
        SELECT ID, CLASS_ID, URL, CREATED_AT
        FROM T_PHOTO
        WHERE CLASS_ID = #{classId}
    </select>

    <select id="select" resultType="ScheduleDTO">
        SELECT ID, CLASS_ID, URL, CREATED_AT
        FROM T_PHOTO
        WHERE ID = #{id}
    </select>

    <insert id="insert">
        INSERT INTO T_PHOTO(CLASS_ID, URL)
        VALUES (#{classId}, #{url})
    </insert>

    <delete id="delete">
        DELETE FROM T_PHOTO
        WHERE ID = #{id}
    </delete>
</mapper>